# CodeAgent Environment Variables Template (MODO LOCAL-ONLY)
# CodeAgent opera 100% en local usando Ollama. No se requieren ni se solicitan API Keys Cloud.

# Configuración de Ollama Local y Servidor Proxy
DEFAULT_MODEL_PROVIDER=Ollama (Local)
DEFAULT_MODEL_NAME=qwen2.5-coder:14b
OLLAMA_API_BASE=http://localhost:11434
PORT=8000

# Sandboxing y Seguridad
STRICT_SANDBOX=0
REQUIRE_TERMINAL_APPROVAL=1
ALLOWED_COMMANDS=pytest,python,pip,ruff,git,ls,dir,cat,node,npm,graphify
