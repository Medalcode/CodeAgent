# CodeAgent Environment Variables Template
# Copia este archivo como .env y completa tus credenciales. NUNCA subas claves a Git.

# Configuración de Proveedores LLM
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Configuración de Servidor y Ollama Local
OLLAMA_HOST=http://localhost:11434
CODEAGENT_PORT=8000
ACTIVE_WORKSPACE_DIR=

# Sandboxing y Seguridad
STRICT_SANDBOX=0
ALLOWED_COMMANDS=pytest,python,pip,ruff,git,ls,dir,cat,node,npm,graphify
