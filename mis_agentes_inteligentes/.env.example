# ──────────────────────────────────────────────────────────────
# OpenCode Hub — Variables de Entorno
# Copia este archivo como .env y rellena los valores que necesites.
# El archivo .env NUNCA debe commitearse al repositorio.
# ──────────────────────────────────────────────────────────────

# ── Ollama (Local) ─────────────────────────────────────────────
# URL base de Ollama si no corre en localhost
# OLLAMA_API_BASE=http://localhost:11434

# ── OpenAI ─────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...

# ── Anthropic ──────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...

# ── Google Gemini ───────────────────────────────────────────────
# GOOGLE_API_KEY=AIza...

# ── Groq ───────────────────────────────────────────────────────
# GROQ_API_KEY=gsk_...

# ── OpenRouter (para el Orquestador Supervisor) ─────────────────
# OPENAI_API_KEY=sk-or-...
# API_BASE=https://openrouter.ai/api/v1
# SUPERVISOR_MODEL=openai/gpt-4o-mini

# ── Modelo local por defecto para el Orquestador ────────────────
# MODELO_LOCAL=qwen2.5-coder:7b
